diff --git a/main/xiaozhi-server/core/api/device_handler.py b/main/xiaozhi-server/core/api/device_handler.py
new file mode 100644
index 0000000..03e377f
--- /dev/null
+++ b/main/xiaozhi-server/core/api/device_handler.py
@@ -0,0 +1,187 @@
+import asyncio
+import json
+import os
+from typing import Any, Optional
+
+from aiohttp import web
+
+from core.api.base_handler import BaseHandler
+
+TAG = __name__
+
+MAX_TIMEOUT = 15.0
+TOKEN_PATHS = (
+    "/opt/xiaozhi-esp32-server/data/.device_tool_token",
+    "data/.device_tool_token",
+)
+
+
+class DeviceHandler(BaseHandler):
+    """External device-control endpoint (hermes-device-control patch).
+
+    POST /device/tool
+        {"name": "self.audio_speaker.set_volume", "arguments": {"volume": 100},
+         "auth_key": "<token>", "device_id": "optional device id"}
+    Header alternative: X-Auth-Key: <token>
+
+    Only device-side tools (names starting with ``self.``) may be called through
+    this endpoint. Anything else is refused.
+    """
+
+    # ---------- helpers ----------
+
+    def _json(self, payload: dict, status: int = 200) -> web.Response:
+        return web.Response(
+            text=json.dumps(payload, ensure_ascii=False, default=str),
+            content_type="application/json",
+            status=status,
+        )
+
+    def _token(self) -> str:
+        try:
+            tk = str(self.config.get("server", {}).get("device_tool_token") or "").strip()
+            if tk:
+                return tk
+        except Exception:
+            pass
+        for path in TOKEN_PATHS:
+            try:
+                if os.path.exists(path):
+                    with open(path, "r", encoding="utf-8") as fh:
+                        return fh.read().strip()
+            except Exception:
+                continue
+        return ""
+
+    def _connections(self) -> dict:
+        from core.connection import ACTIVE_CONNECTIONS
+
+        return ACTIVE_CONNECTIONS
+
+    def _live_connection(self, device_id: Optional[str] = None):
+        conns = self._connections()
+        # drop entries whose websocket is gone
+        for dev in list(conns.keys()):
+            conn = conns.get(dev)
+            ws = getattr(conn, "websocket", None)
+            if ws is None:
+                conns.pop(dev, None)
+                continue
+            closed = getattr(ws, "closed", None)
+            if closed is None:
+                state = getattr(ws, "state", None)
+                closed = getattr(state, "name", "") == "CLOSED"
+            if closed:
+                conns.pop(dev, None)
+        if device_id:
+            return conns.get(device_id)
+        if not conns:
+            return None
+        if len(conns) == 1:
+            return next(iter(conns.values()))
+        return max(
+            conns.values(),
+            key=lambda c: getattr(c, "first_activity_time", 0) or 0,
+        )
+
+    def _to_jsonable(self, value: Any) -> Any:
+        if value is None or isinstance(value, (bool, int, float, str)):
+            return value
+        if isinstance(value, dict):
+            return {str(k): self._to_jsonable(v) for k, v in value.items()}
+        if isinstance(value, (list, tuple, set)):
+            return [self._to_jsonable(v) for v in value]
+        return str(value)
+
+    # ---------- routes ----------
+
+    async def handle_get(self, request):
+        conns = self._connections()
+        devices = []
+        for dev, conn in list(conns.items()):
+            handler = getattr(conn, "func_handler", None)
+            tools = []
+            try:
+                if handler is not None:
+                    tools = [
+                        f.get("function", {}).get("name")
+                        for f in (handler.get_functions() or [])
+                    ]
+            except Exception:
+                pass
+            devices.append({"device_id": dev, "tools": tools})
+        return self._json({"success": True, "devices": devices})
+
+    async def handle_post(self, request):
+        try:
+            body: dict = {}
+            raw = await request.text()
+            if raw and raw.strip():
+                body = json.loads(raw)
+            if not isinstance(body, dict):
+                return self._json(
+                    {"success": False, "message": "body must be a JSON object"}, 400
+                )
+
+            token = self._token()
+            supplied = str(
+                request.headers.get("X-Auth-Key") or body.get("auth_key") or ""
+            ).strip()
+            if token and supplied != token:
+                return self._json({"success": False, "message": "invalid auth key"}, 401)
+
+            name = str(body.get("name") or "").strip()
+            if not name:
+                return self._json({"success": False, "message": "missing 'name'"}, 400)
+            if not name.startswith("self."):
+                return self._json(
+                    {
+                        "success": False,
+                        "message": "only device-side tools (self.*) are allowed",
+                    },
+                    403,
+                )
+
+            arguments = body.get("arguments") or {}
+            if isinstance(arguments, str):
+                arguments = json.loads(arguments) if arguments.strip() else {}
+
+            device_id = body.get("device_id") or request.headers.get("Device-Id")
+            conn = self._live_connection(device_id)
+            if conn is None:
+                return self._json({"success": False, "message": "no connected device"}, 404)
+
+            handler = getattr(conn, "func_handler", None)
+            if handler is None:
+                return self._json(
+                    {"success": False, "message": "device tool handler not ready"}, 503
+                )
+
+            self.logger.bind(tag=TAG).info(
+                f"device tool call: device={getattr(conn, 'device_id', None)} "
+                f"{name} {json.dumps(arguments, ensure_ascii=False)}"
+            )
+            result = await asyncio.wait_for(
+                handler.handle_llm_function_call(
+                    conn, {"name": name, "arguments": arguments}
+                ),
+                timeout=MAX_TIMEOUT,
+            )
+            action = getattr(result, "action", None)
+            return self._json(
+                {
+                    "success": True,
+                    "device_id": getattr(conn, "device_id", None),
+                    "name": name,
+                    "action": getattr(action, "name", None) or str(action),
+                    "result": self._to_jsonable(getattr(result, "result", None)),
+                    "response": self._to_jsonable(getattr(result, "response", None)),
+                }
+            )
+        except asyncio.TimeoutError:
+            return self._json({"success": False, "message": "device timeout"}, 504)
+        except json.JSONDecodeError as exc:
+            return self._json({"success": False, "message": f"bad json: {exc}"}, 400)
+        except Exception as exc:
+            self.logger.bind(tag=TAG).error(f"device tool call failed: {exc}")
+            return self._json({"success": False, "message": str(exc)}, 500)
diff --git a/main/xiaozhi-server/core/connection.py b/main/xiaozhi-server/core/connection.py
index 15ac136..113b2fa 100644
--- a/main/xiaozhi-server/core/connection.py
+++ b/main/xiaozhi-server/core/connection.py
@@ -52,6 +52,34 @@ TAG = __name__
 auto_import_modules("plugins_func.functions")
 
 
+# ===== hermes-device-control patch =====
+# Live device connections, keyed by device id. Lets the /device/tool HTTP
+# endpoint (and therefore Hermes) call the device MCP tools of a connected
+# robot. Added by Hermes; deleting this block restores stock behaviour.
+ACTIVE_CONNECTIONS = {}
+
+
+def register_active_connection(conn):
+    try:
+        dev = getattr(conn, "device_id", None)
+        if dev:
+            ACTIVE_CONNECTIONS[dev] = conn
+    except Exception:
+        pass
+
+
+def unregister_active_connection(conn):
+    try:
+        dev = getattr(conn, "device_id", None)
+        if dev and ACTIVE_CONNECTIONS.get(dev) is conn:
+            ACTIVE_CONNECTIONS.pop(dev, None)
+    except Exception:
+        pass
+
+
+# ===== end hermes-device-control patch =====
+
+
 class TTSException(RuntimeError):
     pass
 
@@ -219,6 +247,7 @@ class ConnectionHandler:
             )
 
             self.device_id = self.headers.get("device-id", None)
+            register_active_connection(self)
 
             # 认证通过,继续处理
             self.websocket = ws
@@ -263,6 +292,7 @@ class ConnectionHandler:
             self.logger.bind(tag=TAG).error(f"Connection error: {str(e)}-{stack_trace}")
             return
         finally:
+            unregister_active_connection(self)
             try:
                 await self._save_and_close(ws)
             except Exception as final_error:
