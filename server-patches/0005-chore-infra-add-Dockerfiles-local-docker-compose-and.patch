new file mode 100644
index 0000000..87d7cec
--- /dev/null
+++ b/Dockerfile.server
@@ -0,0 +1,5 @@
+FROM xiaozhi-server-base:local
+COPY main/xiaozhi-server /opt/xiaozhi-esp32-server
