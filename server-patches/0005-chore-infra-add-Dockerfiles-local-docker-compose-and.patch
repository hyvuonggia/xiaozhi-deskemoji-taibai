+ENV TZ=Asia/Ho_Chi_Minh
+CMD ["python", "app.py"]
diff --git a/Dockerfile.server-base b/Dockerfile.server-base
new file mode 100644
index 0000000..6105cc2
--- /dev/null
+++ b/Dockerfile.server-base
@@ -0,0 +1,12 @@
+FROM python:3.10-slim
+ENV DEBIAN_FRONTEND=noninteractive \
+    PYTHONIOENCODING=utf-8 \
+    LANG=C.UTF-8 \
+    LC_ALL=C.UTF-8 \
+    PIP_DISABLE_PIP_VERSION_CHECK=1
+RUN apt-get update && apt-get install -y --no-install-recommends libopus0 ffmpeg locales ca-certificates && rm -rf /var/lib/apt/lists/*
+WORKDIR /opt/xiaozhi-esp32-server
+COPY main/xiaozhi-server/requirements.txt /tmp/requirements.txt
+RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel && \
+    python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.2.2+cpu torchaudio==2.2.2+cpu && \
+    python -m pip install --no-cache-dir -r /tmp/requirements.txt --default-timeout=120 --retries 5
diff --git a/main/xiaozhi-server/docker-compose.local.yml b/main/xiaozhi-server/docker-compose.local.yml
new file mode 100644
index 0000000..37bd66e
--- /dev/null
+++ b/main/xiaozhi-server/docker-compose.local.yml
@@ -0,0 +1,21 @@
+services:
+  xiaozhi-server:
+    image: xiaozhi-server:phowhisper
+    build:
+      context: ../..
+      dockerfile: Dockerfile.server
+    container_name: xiaozhi-server
+    restart: unless-stopped
+    init: true
+    mem_limit: 3900m
+    cpus: 1.75
+    ports:
+      - "8000:8000"
+      - "8003:8003"
+    environment:
+      TZ: Asia/Ho_Chi_Minh
+    volumes:
+      - ./data:/opt/xiaozhi-esp32-server/data
+      - ./models/vosk/vosk-model-small-vn-0.4:/opt/xiaozhi-esp32-server/models/vosk/vosk-model-small-vn-0.4:ro
+      - ./models/vosk/vosk-model-vn-0.4:/opt/xiaozhi-esp32-server/models/vosk/vosk-model-vn-0.4:ro
+      - ./models/phowhisper-small:/opt/xiaozhi-esp32-server/models/phowhisper-small:ro
diff --git a/piper_http.py b/piper_http.py
new file mode 100755
index 0000000..d4f50aa
--- /dev/null
+++ b/piper_http.py
@@ -0,0 +1,66 @@
+#!/usr/bin/env python3
+"""Local Piper HTTP adapter for Xiaozhi CustomTTS."""
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from io import BytesIO
+import json
+import os
+import threading
+import wave
+
+from piper import PiperVoice
+
+MODEL = os.environ.get("PIPER_MODEL", "/opt/xiaozhi-esp32-server/models/piper/vi_VN-vais1000-medium.onnx")
+CONFIG = os.environ.get("PIPER_CONFIG", MODEL + ".json")
+HOST = os.environ.get("PIPER_HOST", "172.17.0.1")
+PORT = int(os.environ.get("PIPER_PORT", "8879"))
+voice = PiperVoice.load(MODEL, config_path=CONFIG)
+synthesis_lock = threading.Lock()
+
+class Handler(BaseHTTPRequestHandler):
+    def log_message(self, fmt, *args):
+        print("piper-http: " + fmt % args, flush=True)
+
+    def do_GET(self):
+        if self.path != "/health":
+            self.send_error(404)
+            return
+        payload = json.dumps({"ok": True, "voice": "vi_VN-vais1000-medium"}).encode()
+        self.send_response(200)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(payload)))
+        self.end_headers()
+        self.wfile.write(payload)
+
+    def do_POST(self):
+        if self.path != "/tts":
+            self.send_error(404)
+            return
+        try:
+            length = int(self.headers.get("Content-Length", "0"))
+            if length < 1 or length > 8192:
+                self.send_error(400, "request body must be between 1 and 8192 bytes")
+                return
+            body = json.loads(self.rfile.read(length))
+            text = body.get("text") or body.get("input")
+            if not isinstance(text, str) or not text.strip() or len(text) > 2000:
+                self.send_error(400, "text is required (max 2000 chars)")
+                return
+            audio = BytesIO()
+            with synthesis_lock:
+                with wave.open(audio, "wb") as wav:
+                    voice.synthesize_wav(text.strip(), wav)
+            data = audio.getvalue()
+            self.send_response(200)
+            self.send_header("Content-Type", "audio/wav")
+            self.send_header("Content-Length", str(len(data)))
+            self.end_headers()
+            self.wfile.write(data)
+        except (ValueError, json.JSONDecodeError) as exc:
+            self.send_error(400, str(exc))
+        except Exception as exc:
+            print(f"piper-http synthesis error: {exc!r}", flush=True)
+            self.send_error(500, "speech synthesis failed")
+
+if __name__ == "__main__":
+    print(f"Loading Piper voice {MODEL}", flush=True)
+    ThreadingHTTPServer((HOST, PORT), Handler).serve_forever()
