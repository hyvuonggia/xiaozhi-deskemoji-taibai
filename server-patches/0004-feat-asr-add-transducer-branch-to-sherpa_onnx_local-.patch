 1 file changed, 44 insertions(+), 18 deletions(-)

diff --git a/main/xiaozhi-server/core/providers/asr/sherpa_onnx_local.py b/main/xiaozhi-server/core/providers/asr/sherpa_onnx_local.py
index 54c981a..82c02ed 100644
--- a/main/xiaozhi-server/core/providers/asr/sherpa_onnx_local.py
+++ b/main/xiaozhi-server/core/providers/asr/sherpa_onnx_local.py
@@ -52,26 +52,38 @@ class ASRProvider(ASRProviderBase):
             "tokens.txt": os.path.join(self.model_dir, "tokens.txt"),
         }
 
-        # 下载并检查模型文件
-        try:
-            for file_name, file_path in model_files.items():
